# Required for answers. Do not commit the real values.
GROQ_API_KEY=
GROQ_MODEL_NAME=

# Shared secret for POST /voice/ask.
# ElevenLabs sends this value in the X-VerdictAI-Webhook-Secret header.
# Use a long random ASCII string. Do not put this value in frontend code.
ELEVENLABS_WEBHOOK_SECRET=

# Agent id from the ElevenLabs dashboard. The voice button can use a public agent with only this set.
ELEVENLABS_AGENT_ID=

# Required for a private agent. Used only on the server to mint a conversation token.
ELEVENLABS_API_KEY=

# Signs login tokens. Use a long random string in production.
JWT_SECRET=

# Optional. Defaults to a local sqlite file.
DATABASE_URL=

# Qdrant holds the statute vectors. Leave the API key empty for a local Qdrant that has no key.
# The serving collection is verdictai: 384 dimensions, cosine distance.
QDRANT_URL=
QDRANT_API_KEY=

# Same model for indexing and queries. Do not point this collection at a different model.
# Local indexing always uses the TEI server below.
# Render cannot reach a localhost TEI server, so it embeds with this same model in-process.
# huggingface needs HF_API_TOKEN and Inference Providers credits.
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
TEI_BASE_URL=http://localhost:8080
HF_API_TOKEN=
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference

# Unused by retrieval. Do not write these vectors into the verdictai collection.
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small

# How many constitution passages one answer may keep after hybrid search.
# Values outside 1 to 12 are clamped. The default is 8.
ANSWER_CONTEXT_LIMIT=

# Maximum spoken-answer size. Text answers use a larger separate budget.
# About four characters are spoken per token. Default is 180. Lower it to spend fewer voice credits.
VOICE_ANSWER_TOKEN_BUDGET=
